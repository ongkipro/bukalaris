{
  "name": "@bukalaris/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./host": "./src/platform/host.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env src/seed.ts",
    "seed:demo": "node --env-file-if-exists=../../.env src/demo/seed-demo.ts",
    "worker": "node --env-file-if-exists=../../.env src/worker.ts",
    "cleanup": "node --env-file-if-exists=../../.env src/cleanup.ts",
    "bootstrap:console": "node --env-file-if-exists=../../.env src/bootstrap-console.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "better-auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
