# Local development values only. Never put real credentials in this file.
DATABASE_URL=postgres://bukalaris:bukalaris@localhost:5442/bukalaris
# Integration tests use a separate database so they never touch dev data.
TEST_DATABASE_URL=postgres://bukalaris:bukalaris@localhost:5442/bukalaris_test
# Playwright e2e uses its own disposable database (wiped, migrated and seeded on every run).
E2E_DATABASE_URL=postgres://bukalaris:bukalaris@localhost:5442/bukalaris_e2e
# Better Auth: generate your own, e.g. `openssl rand -base64 32`. Placeholder below is NOT secure.
BETTER_AUTH_SECRET=dev-only-placeholder-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
# Storefront host resolution: <store-slug>.<STORE_ROOT_DOMAIN> serves that store.
STORE_ROOT_DOMAIN=localhost
# Per-surface origins (T-70, docs/08-DOMAIN-ROUTING.md DOM-5). Unset locally: every link falls back to BETTER_AUTH_URL and
# plain `localhost` keeps the one-host path mode (/admin, /seller, /s/<slug>). In production each active surface needs its
# own exact https origin without a trailing slash (a missing Owner/Seller/Affiliate/Buyer origin refuses to start sign-in);
# <surface>.localhost hosts also work locally. See docs/DEPLOY-COOLIFY.md.
# PLATFORM_ORIGIN=https://bukalaris.com
# OWNER_ORIGIN=https://owner.bukalaris.com
# APP_ORIGIN=https://app.bukalaris.com
# CHECKOUT_ORIGIN=https://checkout.bukalaris.com
# AFFILIATE_ORIGIN=https://affiliate.bukalaris.com
# BUYER_ORIGIN=https://buyer.bukalaris.com
# LOGS_ORIGIN=https://logs.bukalaris.com
# Optional per-surface session secrets (default: derived from BETTER_AUTH_SECRET by domain separation).
# AUTH_SECRET_OWNER= / AUTH_SECRET_SELLER= / AUTH_SECRET_AFFILIATE= / AUTH_SECRET_BUYER=

# Product image uploads on local disk (git-ignored). In Docker mount a volume here.
MEDIA_DIR=./var/media

# Signs buyer order-status links (/o/<id>.<expiry>.<hmac>); generate your own, e.g. `openssl rand -base64 32`.
ORDER_LINK_SECRET=dev-only-order-link-secret-change-me
# Ad signals (T-38): 32-byte key (base64 or hex) sealing per-store Meta/TikTok server tokens at rest.
# Dev placeholder only; generate per environment with `openssl rand -base64 32`.
INTEGRATION_TOKEN_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Real provider calls stay off until the owner approves a test-event call; set SIGNALS_LIVE=1 to enable them.
# SIGNALS_LIVE=0
# AutoLaris payment callback (T-49): HMAC secret that signs the per-payment callback reference (`?cb=<reff>.<hmac>`), at least 32 bytes.
# Without it no payment instruction is requested and every callback is refused (fail closed). Dev placeholder only; generate your own,
# e.g. `openssl rand -base64 32`. The callback URL is built on PLATFORM_ORIGIN (falls back to BETTER_AUTH_URL).
AUTOLARIS_CALLBACK_SECRET=dev-only-autolaris-callback-secret-change-me-0123456789
# Global buyer identity (T-57): HMAC key ring for keyed contact fingerprints (checkout rate-limit keys never hold a raw phone number).
# `<key_id>:<base64 of 32 bytes>[,<key_id>:<base64>...]`, the first entry is current. Dev placeholder only; generate your own, e.g.
# `echo "k1:$(openssl rand -base64 32)"`. Must differ from every tax-identity and integration key. Missing or malformed: checkout refuses (fail closed).
KEYRING_BUYER_FINGERPRINT=k1:ZGV2LW9ubHktYnV5ZXItZmluZ2VycHJpbnQta2V5LTA=
# T-48 shipping credential ring: AES-256-GCM, purpose-separated from every other key. First key is current; retain old keys until re-seal reports no old envelopes.
# Dev placeholder only. Never store the Mengantar Partner Secret in this file.
KEYRING_SHIPPING_CREDENTIALS=dev1:ZGV2LW9ubHktc2hpcHBpbmcta2V5LXNlcGFyYXRlISE=
# Every real Mengantar call (including reads and sandbox) is blocked until BOTH rotation and old-secret revocation are recorded.
# Owner action: rotate through the provider, use only the secret store, confirm old-secret revocation, record secret-free RUNBOOK evidence, THEN set:
# MENGANTAR_PARTNER_SECRET_ROTATED_AT=<UTC ISO timestamp>
# MENGANTAR_PARTNER_OLD_SECRET_REVOKED=1
# Production routing e-mail domain/forwarding and Partner settlement remain externally gated; .invalid is fake-only.
# MENGANTAR_ROUTING_EMAIL_DOMAIN=<Bukalaris-controlled verified domain>

# T-39/T-47 Mengantar booking (worker). Leave unset locally: bookings use the fake adapter. Placeholders only; real values come from the secret store.
# MENGANTAR_PICKUP_ADDRESS_ID=<registered Mengantar pickup address id>
# MENGANTAR_PICKUP_TIME_ID=<optional pickup time slot id>
# COD bookings are refused unless the owner sets 1 (the worker re-checks it). Keep unset until the COD remittance policy (Q-17, D-22) is applied in production.
# ALLOW_COD_BOOKING=1
# T-43/T-47 buyer-data retention (cleanup.ts): redact contact data of completed/cancelled orders not updated for this many days (integer >= 1). Unset = disabled; set only with the privacy owner (Q-11).
# BUYER_DATA_RETENTION_DAYS=365
# T-45 abandoned-checkout recovery: HMAC key ring that signs the 7-day WhatsApp resume link (`<key_id>:<base64 of 32 bytes>[,<key_id>:<base64>...]`, the first entry signs, every entry verifies).
# Dev placeholder only; generate your own, e.g. `echo "k1:$(openssl rand -base64 32)"`. Must differ from every other key. Missing or malformed: no link is created and every link is refused (fail closed).
KEYRING_CHECKOUT_RESUME=r1:ZGV2LW9ubHktY2hlY2tvdXQtcmVzdW1lLWtleS0wMDE=
